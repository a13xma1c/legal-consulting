# Copy to .env and export, or set these in your hosting provider's config.
FLASK_CONFIG=development            # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///site.db      # e.g. postgresql://user:pass@host/db

# AI assistant. Leave ANTHROPIC_API_KEY unset to run the offline fallback.
AI_PROVIDER=auto                    # auto | anthropic | fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=700
CHAT_RATE_LIMIT=90                  # messages per conversation per window (one human's pace)
CHAT_RATE_WINDOW=300                # seconds
CHAT_IP_RATE_LIMIT=6000             # abuse ceiling per IP (many users share IPs!); 0 = off
CHAT_IP_RATE_WINDOW=300
PROXY_FIX_X_FOR=0                   # number of reverse proxies in front of the app (1 on Heroku/nginx)

# Horizontal scaling: share rate-limit state across all workers/hosts.
REDIS_URL=                          # e.g. redis://localhost:6379/0 (empty = per-process memory)
RATE_LIMIT_STORAGE=auto             # auto | memory | redis
RATE_LIMIT_FAIL_OPEN=true           # allow requests if Redis is unreachable (logged)

# Outbound e-mail (verification links). Leave MAIL_SERVER empty to log e-mails
# instead of sending; in development the link is also shown in the UI.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=no-reply@lexcounsel.example
VERIFY_TOKEN_MAX_AGE=86400          # seconds a verification link stays valid
RESET_TOKEN_MAX_AGE=3600            # seconds a password-reset link stays valid

# Abuse protection: per account / e-mail address, plus a per-IP ceiling (0 = off)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
LOGIN_IP_RATE_LIMIT=500
EMAIL_RATE_LIMIT=5
EMAIL_RATE_WINDOW=3600
EMAIL_IP_RATE_LIMIT=200
# CONTENT_SECURITY_POLICY=          # override the default CSP, or set empty to disable

CONTACT_EMAIL=hello@lexcounsel.example
